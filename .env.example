# 默认不调用真实模型，保留当前确定性逻辑。
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=10

# Redis is optional in M10. Without REDIS_URL, the backend runs in degraded mode.
REDIS_URL=''
REDIS_CONNECT_TIMEOUT_SECONDS=1
COPILOT_RATE_LIMIT_CAPACITY=10
COPILOT_RATE_LIMIT_WINDOW_SECONDS=60
DASHBOARD_CACHE_TTL_SECONDS=60
RAG_CACHE_TTL_SECONDS=300
SESSION_CONTEXT_TTL_SECONDS=1800
SESSION_CONTEXT_MAX_MESSAGES=10
RAG_KNOWLEDGE_VERSION=v1
RAG_RULE_VERSION=v1
RAG_QUERY_REWRITE_PROMPT_VERSION=v1

# OpenAI-compatible 示例：
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=replace-with-your-key
# LLM_MODEL=replace-with-your-model

# Ollama 示例：
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:8b

# 飞书普通通知：群自定义机器人 Webhook，只用于普通协同通知，不支持真实按钮回调。
FEISHU_WEBHOOK_URL=

# 飞书审核卡片：自建应用机器人，用于发送支持 card.action.trigger 回调的审核卡片。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_CALLBACK_VERIFY_TOKEN=
